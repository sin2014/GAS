{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ue-ring.local/schema/usem.blueprint-cpp-migration.schema.json",
  "title": "USEM Blueprint to C++ Migration Assistance Report",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "generatedAtUtc",
    "method",
    "disclaimer",
    "candidates"
  ],
  "properties": {
    "schema": { "const": "com.ue-ring.usem.blueprint-cpp-migration" },
    "schemaVersion": { "type": "string" },
    "generatedAtUtc": { "type": "string" },
    "method": { "const": "semantic-evidence-ranking-v1" },
    "disclaimer": { "type": "string" },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "packageName",
          "assetClass",
          "semanticKind",
          "semanticFile",
          "priority",
          "complexityScore",
          "metrics",
          "nativeSymbols",
          "riskFlags",
          "recommendations"
        ],
        "properties": {
          "packageName": { "type": "string" },
          "assetClass": { "type": "string" },
          "semanticKind": { "type": "string" },
          "semanticFile": { "type": "string" },
          "priority": { "enum": ["low", "medium", "high"] },
          "complexityScore": { "type": "integer", "minimum": 0 },
          "metrics": {
            "type": "object",
            "required": [
              "graphs",
              "nodes",
              "variables",
              "components",
              "timelines",
              "nativeLinks",
              "diagnostics"
            ],
            "additionalProperties": { "type": "integer", "minimum": 0 }
          },
          "nativeSymbols": { "type": "array", "items": { "type": "string" } },
          "riskFlags": { "type": "array", "items": { "type": "string" } },
          "recommendations": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
